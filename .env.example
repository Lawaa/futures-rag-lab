# Futures RAG Lab Environment Configuration
# Copy this file to .env and fill in your values

# --- Storage Paths ---
RAG_DATA_PATH=./data
RAG_DB_PATH=./chroma_db

# --- Embeddings ---
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Interface Language ---
RAG_LANGUAGE=en

# --- Language Model ---
RAG_LLM_PROVIDER=gemini
RAG_GEMINI_MODEL=gemini-3.5-flash-lite
RAG_OLLAMA_MODEL=qwen2.5:7b
RAG_OLLAMA_BASE_URL=http://localhost:11434

# --- Rate Limiting ---
RAG_LLM_REQUESTS_PER_MINUTE=0

# --- Chunking ---
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200

# --- Retrieval (MMR) ---
RAG_RETRIEVER_K=6
RAG_RETRIEVER_FETCH_K=20
RAG_RETRIEVER_LAMBDA_MULT=0.7

# --- Cross-lingual Retrieval & Self-Correction ---
RAG_RETRIEVAL_LANGUAGE=en
RAG_ENABLE_SELF_CORRECTION=true
RAG_MAX_RETRIEVAL_RETRIES=3
RAG_ENABLE_GROUNDEDNESS_CHECK=true

# --- Multi-Query Retrieval ---
RAG_ENABLE_MULTI_QUERY=false
RAG_MULTI_QUERY_COUNT=3

# --- Durable Graph State ---
RAG_ENABLE_CHECKPOINTING=true

# --- Multi-Business Profiles ---
RAG_PROFILES_PATH=./profiles.json
RAG_PROFILE=default
RAG_ENABLE_PROFILE_ROUTING=false

# --- API Server ---
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000

# --- AWS S3 Configuration (Optional) ---
# Set USE_S3_STORAGE=true to enable S3 document storage
# When enabled, documents will be uploaded to/retrieved from S3 instead of local storage
RAG_USE_S3_STORAGE=false
RAG_AWS_ACCESS_KEY_ID=your_aws_access_key_id
RAG_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
RAG_AWS_REGION=eu-central-1
RAG_AWS_S3_BUCKET_NAME=futures-rag-lab-docs
