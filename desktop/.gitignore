# --- Rust / Tauri build outputs (generated by `tauri build`) ---
src-tauri/target/
src-tauri/gen/

# Generated application icons (produced by `npm run tauri icon app-icon.png`).
# Keep icons/README.md tracked; CI regenerates icons before packaging.
src-tauri/icons/*.png
src-tauri/icons/*.ico
src-tauri/icons/*.icns
src-tauri/icons/*.svg
src-tauri/icons/android/
src-tauri/icons/ios/

# Frozen backend sidecar (produced by scripts/build_backend.py in CI / local build).
# Do NOT commit these — the release workflow rebuilds them per platform.
src-tauri/binaries/rag-backend*

# Node / Tauri CLI install tree
node_modules/

# PyInstaller intermediate output (created at repo root during backend build)
/build/
/dist/

# Keep lockfiles tracked for reproducible CI (do not ignore):
#   desktop/package-lock.json
#   desktop/src-tauri/Cargo.lock
