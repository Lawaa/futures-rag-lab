{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Futures Trading Assistant",
  "version": "0.1.0",
  "identifier": "com.futuresrag.assistant",
  "build": {
    "frontendDist": "../frontend",
    "beforeBuildCommand": "python scripts/build_backend.py"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Futures Trading Assistant",
        "width": 1100,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Retrieval-Augmented Generation assistant for futures trading.",
    "longDescription": "A local desktop assistant that answers questions about futures trading, grounded in your own documents. Bundles its own runtime so nothing needs to be installed.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/rag-backend"],
    "resources": []
  },
  "plugins": {}
}
